{
  "id": "room-expansion",
  "title": "Inline Room expansion and detail plate",
  "viewport": {
    "width": 1800,
    "height": 1125
  },
  "readySelector": "[data-vqa=\"graph-stage\"]",
  "initialWait": 900,
  "thresholds": {
    "minimumFrameOccupancy": 0.45,
    "maximumGapRatio": 1.5,
    "maximumZoomChange": 0.1,
    "maximumMedianTravel": 120
  },
  "measurements": [
    {
      "name": "stage",
      "selector": "[data-vqa=\"graph-stage\"]",
      "styles": [
        "--stage-zoom"
      ]
    },
    {
      "name": "room frames",
      "selector": "[data-vqa=\"room-frame\"]",
      "all": true
    },
    {
      "name": "nested nodes",
      "selector": "[data-vqa-nested=\"true\"]",
      "all": true
    },
    {
      "name": "detail plates",
      "selector": "[data-vqa=\"detail-plate\"]",
      "all": true
    }
  ],
  "steps": [
    {
      "name": "root",
      "screenshot": true
    },
    {
      "name": "inside-frontend",
      "action": {
        "type": "click",
        "selector": "[data-vqa-action=\"toggle-room-inline\"]",
        "index": 0
      },
      "waitFor": "[data-vqa=\"room-frame\"]",
      "wait": 700,
      "screenshot": true,
      "motion": {
        "samples": 24,
        "intervalMs": 15
      }
    },
    {
      "name": "inside-gateway",
      "action": {
        "type": "clickText",
        "selector": ".node-compact-pill",
        "text": "API Gateway"
      },
      "wait": 700,
      "screenshot": true
    },
    {
      "name": "detail-postgres",
      "action": {
        "type": "clickText",
        "selector": ".node-compact-pill",
        "text": "PostgreSQL"
      },
      "waitFor": "[data-vqa=\"detail-plate\"]",
      "wait": 500,
      "screenshot": true,
      "motion": {
        "samples": 24,
        "intervalMs": 15
      }
    },
    {
      "name": "detail-flow-lod",
      "action": {
        "type": "evaluate",
        "expression": "(() => { const b = document.querySelector('button[aria-label=\"\u7e2e\u5c0f\"]'); if (!b) throw new Error('zoom-out button not found'); b.click(); b.click(); return { clicked: 'zoom out x2' }; })()"
      },
      "wait": 700,
      "screenshot": true,
      "thresholds": {
        "maximumZoomChange": 1,
        "maximumMedianTravel": 400
      }
    }
  ]
}
