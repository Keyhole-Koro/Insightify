{
  "name": "insightify",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/desktop",
    "packages/*"
  ],
  "overrides": {
    "which": "2.0.2"
  },
  "scripts": {
    "dev": "bun --cwd apps/desktop start",
    "preview": "bun --cwd apps/desktop preview",
    "package": "bun --cwd apps/desktop package",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "lint": "bun run --filter '*' lint",
    "build:renderer": "bun run --filter @insightify/desktop build:renderer"
  }
}
